# FOSDEM Explorer Configuration
# Copy this file to .env and customize as needed

# Application settings
FOSDEM_DEBUG=true
FOSDEM_VERSION=0.1.0

# Server settings
FOSDEM_HOST=0.0.0.0
FOSDEM_PORT=8000

# Database
FOSDEM_DATABASE_PATH=data/fosdem.duckdb

# Scraper settings
FOSDEM_SCRAPE_INTERVAL_MINUTES=5
FOSDEM_SCHEDULE_URL=https://fosdem.org/2026/schedule/xml

# FOSDEM year
FOSDEM_YEAR=2026
